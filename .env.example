# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database & Cache Configuration (Optional / External Infrastructure)
DATABASE_URL=""
REDIS_URL=""

# Authentication Secrets & OAuth
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Storage Abstraction (S3 / R2 / Supabase)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""

# Realtime Voice & Video SFU (LiveKit)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Multi-Provider AI Keys (Server-side only)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
# 9Router Proxy. For Docker Desktop use host.docker.internal; native dev can use localhost.
NINEROUTER_BASE_URL="http://localhost:20128/v1"
NINEROUTER_DOCKER_BASE_URL="http://host.docker.internal:20128/v1"
NINEROUTER_API_KEY=""
# OpenClaw must be reachable from the app container; host.docker.internal works on Docker Desktop.
OPENCLAW_BASE_URL=""
OPENCLAW_API_KEY=""
GOOGLE_AI_API_KEY=""

# Midtrans Payment Gateway (Server-side & Client Snap)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Baileys WhatsApp Multi-Device Notification Gateway
WHATSAPP_SUPERVISOR_PHONE="6281234567890"
