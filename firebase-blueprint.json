  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Public human user profiles."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Isolated PII user profile data."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Multi-tenant workspaces."
    },
    "/workspaces/{workspaceId}/departments/{departmentId}": {
      "schema": { "$ref": "#/entities/Department" },
      "description": "Departments within a workspace."
    },
    "/workspaces/{workspaceId}/aiEmployees/{aiId}": {
      "schema": { "$ref": "#/entities/AIEmployee" },
      "description": "AI Workforce employees in a workspace."
    },
    "/workspaces/{workspaceId}/aiTasks/{taskId}": {
      "schema": { "$ref": "#/entities/AITask" },
      "description": "AI tasks, deliverables, and approval states."
    },
    "/workspaces/{workspaceId}/aiActivityLogs/{logId}": {
      "schema": { "$ref": "#/entities/AIActivityLog" },
      "description": "Immutable AI activity and governance audit trail."
    },
    "/workspaces/{workspaceId}/presence/{playerId}": {
      "schema": { "$ref": "#/entities/PlayerPresence" },
      "description": "Realtime 2D multiplayer player positions and presence."
    },
    "/workspaces/{workspaceId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Realtime global, room, proximity, and AI chat messages."
    },
    "/workspaces/{workspaceId}/maps/{mapId}": {
      "schema": { "$ref": "#/entities/OfficeMap" },
      "description": "2D Virtual Office map layouts and interactive objects."
    },
    "/workspaces/{workspaceId}/knowledge/{docId}": {
      "schema": { "$ref": "#/entities/AIKnowledgeDoc" },
      "description": "Department knowledge base documents for RAG."
    },
    "/workspaces/{workspaceId}/kpis/{kpiId}": {
      "schema": { "$ref": "#/entities/AIKpi" },
      "description": "Department and AI Employee KPIs."
    }
  }
}
